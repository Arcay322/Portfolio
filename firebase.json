{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "predeploy": [
      "npm run build:firebase",
      "npm run test:portfolio"
    ],
    "redirects": [
      {
        "source": "/es",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/es/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/projects",
        "destination": "/#proyectos",
        "type": 301
      },
      {
        "source": "/projects/",
        "destination": "/#proyectos",
        "type": 301
      },
      {
        "source": "/about",
        "destination": "/#trayectoria",
        "type": 301
      },
      {
        "source": "/about/",
        "destination": "/#trayectoria",
        "type": 301
      },
      {
        "source": "/contact",
        "destination": "/#contacto",
        "type": 301
      },
      {
        "source": "/contact/",
        "destination": "/#contacto",
        "type": 301
      },
      {
        "source": "/en/projects",
        "destination": "/en/#proyectos",
        "type": 301
      },
      {
        "source": "/en/projects/",
        "destination": "/en/#proyectos",
        "type": 301
      },
      {
        "source": "/en/about",
        "destination": "/en/#trayectoria",
        "type": 301
      },
      {
        "source": "/en/about/",
        "destination": "/en/#trayectoria",
        "type": 301
      },
      {
        "source": "/en/contact",
        "destination": "/en/#contacto",
        "type": 301
      },
      {
        "source": "/en/contact/",
        "destination": "/en/#contacto",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'sha256-o+Xsy/d2DQRVCxbHpPK7IOQqVV3d2qQxvDVKCmpTE9c=' 'sha256-Ka58UPQ0yfAMGRRkYEQgj+blHQTlf72V5XEt/i3CXKA=' 'sha256-4iu4O0KgN0PqA+rLX9tZT4KWRzTA6PArQJFsgAuKHJs='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests"
          },
          {
            "key": "Cache-Control",
            "value": "public,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=604800"
          }
        ]
      },
      {
        "source": "/images/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=86400"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/chat",
        "function": {
          "functionId": "chat",
          "region": "us-central1"
        }
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": false
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}
